#: ink_sheet_bar.lua main.lua
msgid "Close sheet"
msgstr "Cerrar hoja"

#: main.lua
msgid "Stylus input requires KOReader v2026.07 or newer"
msgstr "La entrada con lápiz óptico requiere KOReader v2026.07 o posterior"

#: main.lua
msgid "Another plugin is already using stylus input"
msgstr "Otro complemento ya está usando la entrada del lápiz óptico"

#: main.lua
msgid "JustDraw: cannot hook touch input"
msgstr "JustDraw: no se puede interceptar la entrada táctil"

#: main.lua
msgid "Pen input needs KOReader v2026.07 or newer. Drawing with finger."
msgstr "La entrada con lápiz necesita KOReader v2026.07 o posterior. Se dibujará con el dedo."

#: main.lua
msgid ""
"This device does not say which input slot its pen uses, so the pen route is "
"unavailable."
msgstr "Este dispositivo no indica qué ranura de entrada usa su lápiz, así que la ruta del lápiz no está disponible."

#: main.lua
msgid "JustDraw: input is already captured"
msgstr "JustDraw: la entrada ya está capturada"

#: main.lua
msgid "JustDraw: drawing stopped after an input error"
msgstr "JustDraw: el dibujo se detuvo tras un error de entrada"

#: main.lua
msgid "JustDraw"
msgstr "JustDraw"

#: main.lua
msgid "Open sheet here"
msgstr "Abrir hoja aquí"

#: main.lua
msgid "Open a drawing sheet to draw in this book: %1 ▸ %2 ▸ %3."
msgstr "Abre una hoja de dibujo para dibujar en este libro: %1 ▸ %2 ▸ %3."

#: main.lua
msgid "This sheet belongs to page %1. Go back to it, or open a sheet here."
msgstr "Esta hoja pertenece a la página %1. Vuelve a ella o abre una hoja aquí."

#: main.lua
msgid ""
"This sheet belongs to another place in the book. Go back to it, or open a "
"sheet here."
msgstr "Esta hoja pertenece a otro lugar del libro. Vuelve a él o abre una hoja aquí."

#: main.lua
msgid "JustDraw: toggle drawing"
msgstr "JustDraw: activar/desactivar dibujo"

#: main.lua
msgid "JustDraw: toggle eraser"
msgstr "JustDraw: activar/desactivar goma"

#: main.lua
msgid "JustDraw: undo stroke"
msgstr "JustDraw: deshacer trazo"

#: main.lua
msgid "JustDraw: redo"
msgstr "JustDraw: rehacer"

#: main.lua
msgid "JustDraw: toggle toolbar"
msgstr "JustDraw: mostrar/ocultar barra de herramientas"

#: main.lua
msgid "JustDraw: open notebooks"
msgstr "JustDraw: abrir cuadernos"

#: main.lua
msgid "JustDraw: browse document notes"
msgstr "JustDraw: explorar notas del documento"

#: main.lua
msgid "JustDraw: open/close drawing sheet"
msgstr "JustDraw: abrir/cerrar hoja de dibujo"

#: main.lua
msgid "JustDraw: toggle marker/pen"
msgstr "JustDraw: alternar rotulador/pluma"

#: main.lua
msgid "This sheet is read-only"
msgstr "Esta hoja es de solo lectura"

#: main.lua
msgid "Could not save ink. Use Retry saving before drawing again."
msgstr "No se pudo guardar la tinta. Usa Reintentar guardado antes de volver a dibujar."

#: main.lua
msgid "This sheet's ink is still loading"
msgstr "La tinta de esta hoja aún se está cargando"

#: main.lua
msgid "Input mode is set to Finger. Set it to Automatic or Stylus."
msgstr "El modo de entrada está en Dedo. Cámbialo a Automático o Lápiz óptico."

#: main.lua
msgid "This KOReader has no stylus API. The pen route needs v2026.07 or newer."
msgstr "Este KOReader no tiene API de lápiz óptico. La ruta del lápiz necesita v2026.07 o posterior."

#: main.lua
msgid "Another plugin already owns the stylus input callback."
msgstr "Otro complemento ya tiene asignado el callback de entrada del lápiz óptico."

#: main.lua
msgid ""
"This device does not report a pen digitizer. Set Input mode to Stylus by "
"hand."
msgstr "Este dispositivo no informa de un digitalizador de lápiz. Pon el modo de entrada en Lápiz óptico manualmente."

#: main.lua
msgid ""
"Pen coordinates will be written to the local KOReader log for up to 60 "
"seconds. JustDraw does not upload them; shared logs may contain them. Turn "
"KOReader's debug logging off again afterwards: it records all raw input and "
"the file grows very quickly."
msgstr "Las coordenadas del lápiz se escribirán en el registro local de KOReader durante un máximo de 60 segundos. JustDraw no las sube a ningún sitio, pero los registros que compartas pueden contenerlas. Después, vuelve a desactivar el registro de depuración de KOReader: guarda toda la entrada sin procesar y el archivo crece muy rápido."

#: main.lua
msgid "Start"
msgstr "Iniciar"

#: main.lua
msgid "Cannot anchor a sheet at this position"
msgstr "No se puede anclar una hoja en esta posición"

#: main.lua
msgid "Drawing sheets need an open book"
msgstr "Las hojas de dibujo necesitan un libro abierto"

#: main.lua
msgid "Drawing sheets are not available in this document"
msgstr "Las hojas de dibujo no están disponibles en este documento"

#: main.lua
msgid "Pen style: marker"
msgstr "Estilo de pluma: rotulador"

#: main.lua
msgid "Pen style: marker (needs a sheet here)"
msgstr "Estilo de pluma: rotulador (necesita una hoja aquí)"

#: main.lua
msgid "Pen style: ink pen"
msgstr "Estilo de pluma: pluma de tinta"

#: main.lua
msgid "Nothing to undo on this page"
msgstr "Nada que deshacer en esta página"

#: main.lua
msgid "Nothing to undo on this sheet"
msgstr "Nada que deshacer en esta hoja"

#: main.lua
msgid "Nothing to redo on this sheet"
msgstr "Nada que rehacer en esta hoja"

#: main.lua
msgid "Redo is available on notebooks and sheets"
msgstr "Rehacer está disponible en cuadernos y hojas"

#: main.lua
msgid "Sheet height: %1 %"
msgstr "Altura de la hoja: %1 %"

#: main.lua
msgid "Delete sheet"
msgstr "Borrar hoja"

#: main.lua
msgid "Toolbar side"
msgstr "Lado de la barra de herramientas"

#: main.lua
#, lua-format
msgid "Sheet %d"
msgstr "Hoja %d"

#: main.lua
msgid "Sheets at this position"
msgstr "Hojas en esta posición"

#: main.lua
msgid "Delete this sheet and everything drawn on it?"
msgstr "¿Borrar esta hoja y todo lo dibujado en ella?"

#: main.lua
msgid "Could not delete this sheet"
msgstr "No se pudo borrar esta hoja"

#: main.lua
msgid "Go to this sheet's page"
msgstr "Ir a la página de esta hoja"

#: main.lua
msgid ""
"The sheet stays open while you read on, and it does not follow the page: it "
"hangs on a position in the text. This goes back to that position, which is "
"the only place it will take ink."
msgstr "La hoja sigue abierta mientras sigues leyendo y no acompaña a la página: está anclada a una posición del texto. Esto vuelve a esa posición, que es el único lugar donde admite tinta."

#: main.lua
msgid "Open a sheet here instead"
msgstr "Abrir una hoja aquí en su lugar"

#: main.lua
msgid "Delete this sheet"
msgstr "Borrar esta hoja"

#: main.lua
msgid "Indexing sheets %1/%2"
msgstr "Indexando hojas %1/%2"

#: main.lua
msgid "Indexing sheets %1"
msgstr "Indexando hojas %1"

#: main.lua
msgid ""
"Creates a blank sheet anchored to this position in the book, or opens the "
"one that is already here. The sheet keeps its own coordinates, so changing "
"font or margins moves the sheet, not what you drew on it."
msgstr "Crea una hoja en blanco anclada a esta posición del libro, o abre la que ya está aquí. La hoja conserva sus propias coordenadas, así que cambiar la fuente o los márgenes mueve la hoja, no lo que dibujaste en ella."

#: main.lua
msgid "Retry saving ink"
msgstr "Reintentar guardado de tinta"

#: main.lua
msgid ""
"A write to the sheet database failed. Nothing has been lost -- the strokes "
"are still in memory -- but they are not durable until this succeeds, and no "
"more can be drawn until it does."
msgstr "Falló una escritura en la base de datos de hojas. No se ha perdido nada —los trazos siguen en memoria—, pero no quedarán guardados de forma permanente hasta que esto funcione, y no se puede dibujar más hasta entonces."

#: main.lua
msgid "Retry loading sheet"
msgstr "Reintentar carga de la hoja"

#: main.lua
msgid "Sheets on this page"
msgstr "Hojas en esta página"

#: main.lua
#, lua-format
msgid "Lost sheet %d"
msgstr "Hoja perdida %d"

#: main.lua
msgid "Open it anyway"
msgstr "Abrirla de todos modos"

#: main.lua
msgid "Delete it"
msgstr "Borrarla"

#: main.lua
#, lua-format
msgid "Lost sheets (%d)"
msgstr "Hojas perdidas (%d)"

#: main.lua
msgid ""
"Sheets whose place in the book can no longer be found -- usually because the "
"file was replaced with a different edition. Nothing drawn on them has been "
"lost."
msgstr "Hojas cuya posición en el libro ya no se encuentra, normalmente porque el archivo se sustituyó por otra edición. No se ha perdido nada de lo dibujado en ellas."

#: main.lua
msgid ""
"Delete the ink on this page? Drawing sheets and legacy ink are not affected."
msgstr "¿Borrar la tinta de esta página? Las hojas de dibujo y la tinta antigua no se ven afectadas."

#: main.lua
msgid ""
"Delete the ink on every page of this book? Drawing sheets and legacy ink are "
"not affected."
msgstr "¿Borrar la tinta de todas las páginas de este libro? Las hojas de dibujo y la tinta antigua no se ven afectadas."

#: main.lua
msgid ""
"A write to the page-ink database failed. Nothing has been lost -- the "
"strokes are still in memory -- but they are not durable until this succeeds, "
"and no more can be drawn until it does."
msgstr "Falló una escritura en la base de datos de tinta de página. No se ha perdido nada —los trazos siguen en memoria—, pero no quedarán guardados de forma permanente hasta que esto funcione, y no se puede dibujar más hasta entonces."

#: main.lua
msgid "Delete this page note"
msgstr "Borrar esta nota de página"

#: main.lua
msgid "Delete all page notes"
msgstr "Borrar todas las notas de página"

#: main.lua
msgid ""
"Deletes the ink drawn on the pages of this book. Drawing sheets and ink "
"drawn before this KOReader version are not affected."
msgstr "Borra la tinta dibujada en las páginas de este libro. No afecta a las hojas de dibujo ni a la tinta dibujada antes de esta versión de KOReader."

#: main.lua
msgid ""
"Blank sheets anchored to a position in a reflowable book. Not available in "
"PDFs and other fixed layouts, where drawing goes straight onto the page "
"instead."
msgstr "Hojas en blanco ancladas a una posición de un libro con texto ajustable. No disponibles en PDF ni en otros diseños fijos, donde se dibuja directamente sobre la página."

#: main.lua
msgid ""
"Browse every JustDraw note in this book, read it at full size, go to its "
"location, or export a selection."
msgstr "Explora todas las notas de JustDraw de este libro, léelas a tamaño completo, ve a su ubicación o exporta una selección."

#: main.lua
msgid "Start drawing"
msgstr "Empezar a dibujar"

#: main.lua
msgid ""
"Use the Draw/Stop button on the side toolbar to switch drawing off again. "
"Two fingers also work as usual while drawing is on."
msgstr "Usa el botón Dibujar/Parar de la barra lateral para volver a desactivar el dibujo. Los gestos con dos dedos siguen funcionando como siempre mientras el dibujo está activado."

#: main.lua
msgid "Show toolbar"
msgstr "Mostrar barra de herramientas"

#: main.lua
msgid "Left"
msgstr "Izquierda"

#: main.lua
msgid "Right"
msgstr "Derecha"

#: main.lua
msgid ""
"Automatic uses the stylus route on devices that report a pen digitizer, and "
"the finger route everywhere else. On a drawing sheet, finger and palm never "
"draw; touches above the bounded sheet can still turn pages. With direct ink, "
"press Stop to return all touch input to reading."
msgstr "Automático usa la ruta del lápiz óptico en los dispositivos que informan de un digitalizador de lápiz, y la ruta del dedo en todos los demás. En una hoja de dibujo, el dedo y la palma nunca dibujan; los toques por encima de la hoja delimitada aún pueden pasar páginas. Con tinta directa, pulsa Parar para devolver toda la entrada táctil a la lectura."

#: main.lua
msgid "Pen style"
msgstr "Estilo de pluma"

#: main.lua
msgid "Pen width"
msgstr "Grosor de pluma"

#: main.lua
msgid "Fast refresh while drawing"
msgstr "Refresco rápido al dibujar"

#: main.lua
msgid ""
"On: strokes appear with the DU waveform — quick, but grainy and it leaves "
"ghosting until the next page turn. Off: slower, cleaner."
msgstr "Activado: los trazos aparecen con la forma de onda DU — rápido, pero granulado, y deja imágenes fantasma hasta el siguiente cambio de página. Desactivado: más lento y más limpio."

#: main.lua
msgid ""
"Shows why the pen route is or is not running. With confirmation, it writes "
"pen coordinates and decisions to the local log for up to one minute or 8,192 "
"events. No book or notebook identity is logged."
msgstr "Muestra por qué la ruta del lápiz está o no en funcionamiento. Si lo confirmas, escribe las coordenadas y decisiones del lápiz en el registro local durante un máximo de un minuto o 8192 eventos. No se registra la identidad de ningún libro ni cuaderno."

#: main.lua
msgid ""
"Writes what you have drawn to a PDF, PNG or JPEG in a folder of your "
"choosing. Exports the page you are reading, the sheet that is open, or every "
"sheet in this book. Nothing in the book itself is changed."
msgstr "Guarda lo que has dibujado en un PDF, PNG o JPEG en la carpeta que elijas. Exporta la página que estás leyendo, la hoja abierta o todas las hojas de este libro. El libro en sí no se modifica."

#: main.lua
msgid "Clear this page"
msgstr "Limpiar esta página"

#: main.lua
msgid "No ink on this page"
msgstr "No hay tinta en esta página"

#: main.lua
msgid "Clear whole document"
msgstr "Limpiar todo el documento"

#: main.lua
msgid "No ink in this document"
msgstr "No hay tinta en este documento"

#: main.lua
msgid "Delete all ink in this document?"
msgstr "¿Borrar toda la tinta de este documento?"

#: main.lua
msgid "Clear legacy ink on this stored page"
msgstr "Limpiar la tinta antigua de esta página guardada"

#: main.lua
msgid ""
"Ink drawn on this page by an older JustDraw or FingerInk, in screen pixels. "
"It is shown and exported as it was stored, and this is the only thing that "
"can change it."
msgstr "Tinta dibujada en esta página con una versión antigua de JustDraw o FingerInk, en píxeles de pantalla. Se muestra y se exporta tal como se guardó, y esta es la única opción que puede cambiarla."

#: main.lua
msgid "Clear all legacy ink"
msgstr "Limpiar toda la tinta antigua"

#: main.lua
msgid ""
"Delete the legacy ink stored for page %1? Drawing sheets and page notes are "
"not affected."
msgstr "¿Borrar la tinta antigua guardada para la página %1? Las hojas de dibujo y las notas de página no se ven afectadas."

#: main.lua
msgid ""
"Delete all legacy ink in this book? Drawing sheets and page notes are not "
"affected."
msgstr "¿Borrar toda la tinta antigua de este libro? Las hojas de dibujo y las notas de página no se ven afectadas."

#: main.lua
msgid ""
"Ink drawn on the pages of a PDF or another fixed layout, stored in the "
"page's own units so it follows zoom and panning. Not available in reflowable "
"books, where a drawing sheet is anchored to the text instead."
msgstr "Tinta dibujada en las páginas de un PDF u otro diseño fijo, guardada en las unidades propias de la página para que siga el zoom y el desplazamiento. No disponible en libros con texto ajustable, donde en su lugar se ancla una hoja de dibujo al texto."
