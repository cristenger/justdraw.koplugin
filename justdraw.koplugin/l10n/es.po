#: ink_refresh_dialog.lua
msgid ""
"For graphite, marker, and pages containing gray ink. Lower intervals update "
"the screen more often."
msgstr "Para grafito, rotulador y páginas con tinta gris. Los intervalos más cortos actualizan la pantalla con más frecuencia."

#: ink_selection.lua
msgid "The selection could not be completed."
msgstr "No se pudo completar la selección."

#: ink_selection.lua
msgid "That lasso was too long. Draw a shorter one."
msgstr "Ese lazo era demasiado largo. Dibuja uno más corto."

#: ink_selection.lua
msgid "That lasso is too complex. Draw a simpler one."
msgstr "Ese lazo es demasiado complejo. Dibuja uno más sencillo."

#: ink_selection.lua
