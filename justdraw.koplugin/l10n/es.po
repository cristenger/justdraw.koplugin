msgstr "No se pudo leer la selección."

#: ink_selection.lua
msgid "Too much ink for one selection. Select less."
msgstr "Demasiada tinta para una sola selección. Selecciona menos."

#: ink_selection.lua
msgid "That selection is too large to move. Select less."
msgstr "Esa selección es demasiado grande para moverla. Selecciona menos."

#: ink_selection.lua
msgid "The selection could not be prepared."
msgstr "No se pudo preparar la selección."

#: ink_selection.lua
