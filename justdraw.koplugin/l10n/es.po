msgstr[0] "¿Borrar %1 elemento? Esto no se puede deshacer."
msgstr[1] "¿Borrar estos %1 elementos? Esto no se puede deshacer."

#: ink_notebook_library.lua
msgid "Folder “%1”"
msgstr "Carpeta “%1”"

#: ink_notebook_library.lua
msgid ""
"Notebooks inside a deleted folder are not deleted: they go back to Notebooks."
msgstr "Los cuadernos de una carpeta borrada no se borran: vuelven a Cuadernos."

#: ink_notebook_library.lua
msgid "Couldn’t delete this folder. Try again."
msgstr "No se pudo borrar esta carpeta. Inténtalo de nuevo."

#: ink_notebook_session.lua
msgid ""
"This page changed since it was last open, so its undo history was cleared."
msgstr "Esta página cambió desde la última vez que se abrió, así que se borró su historial de deshacer."

#: ink_notebook_ui.lua
msgid ""
"This screen is too small for the notebook controls. Rotate the device or "
"lower the screen DPI and try again."
msgstr "Esta pantalla es demasiado pequeña para los controles del cuaderno. Gira el dispositivo o baja los DPI de la pantalla e inténtalo de nuevo."

#: ink_notebook_ui.lua main.lua
msgid "Stroke was not saved because the write queue is busy. Try again."
msgstr "El trazo no se guardó porque la cola de escritura está ocupada. Inténtalo de nuevo."

#: ink_notebook_ui.lua main.lua
msgid ""
"Stroke stopped because the pen contact did not end. Lift the pen and try "
"again."
msgstr "El trazo se detuvo porque el contacto del lápiz no terminó. Levanta el lápiz e inténtalo de nuevo."

