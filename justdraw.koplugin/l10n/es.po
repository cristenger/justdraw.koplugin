#: ink_export_dialog.lua
msgid "That folder no longer exists. Choose another one."
msgstr "Esa carpeta ya no existe. Elige otra."

#: ink_export_dialog.lua
msgid "Nothing can be written to that folder. Choose another one."
msgstr "No se puede escribir nada en esa carpeta. Elige otra."

#: ink_export_dialog.lua
msgid "That file name can’t be used. Choose another one."
msgstr "Ese nombre de archivo no se puede usar. Elige otro."

#: ink_export_dialog.lua
msgid "That file type isn’t supported."
msgstr "Ese tipo de archivo no es compatible."

#: ink_export_dialog.lua
msgid "That image quality isn’t supported."
msgstr "Esa calidad de imagen no es compatible."

#: ink_export_dialog.lua
msgid "There’s nothing to export here."
msgstr "Aquí no hay nada que exportar."

#: ink_export_dialog.lua
msgid "The sheets in this book are still being located. Try again in a moment."
msgstr "Aún se están localizando las hojas de este libro. Inténtalo de nuevo en un momento."

#: ink_export_dialog.lua
msgid ""
"This document can’t be exported yet. Only fixed-layout documents, such as "
"PDFs, can."
msgstr "Este documento aún no se puede exportar. Solo se pueden exportar documentos de diseño fijo, como los PDF."

#: ink_export_dialog.lua
msgid "Turn off continuous scrolling to export the page you’re reading."
msgstr "Desactiva el desplazamiento continuo para exportar la página que estás leyendo."

#: ink_export_dialog.lua
msgid "This page is too large to export."
msgstr "Esta página es demasiado grande para exportarla."

#: ink_export_dialog.lua
msgid ""
"This selection has too many pages to export at once. Export a smaller range."
msgstr "Esta selección tiene demasiadas páginas para exportarlas de una vez. Exporta un rango más pequeño."

#: ink_export_dialog.lua
msgid ""
"A note’s page size no longer matches the document. Export the notes "
"separately."
msgstr "El tamaño de página de una nota ya no coincide con el documento. Exporta las notas por separado."

#: ink_export_dialog.lua
msgid "This note’s saved data cannot be read. Nothing was exported."
msgstr "No se pueden leer los datos guardados de esta nota. No se exportó nada."

#: ink_export_dialog.lua
msgid "The EPUB conversion stopped. The original document was not changed."
msgstr "La conversión del EPUB se detuvo. El documento original no se modificó."

#: ink_export_dialog.lua
msgid "This page’s size can’t be used for an export."
msgstr "El tamaño de esta página no se puede usar para exportar."

#: ink_export_dialog.lua ink_notebook_editor.lua ink_notebook_ui.lua
msgid "Lift the pen and try again."
msgstr "Levanta el lápiz e inténtalo de nuevo."

#: ink_export_dialog.lua
msgid ""
"The exported file couldn’t be put in place. Check the folder and try again."
msgstr "No se pudo colocar el archivo exportado en su sitio. Revisa la carpeta e inténtalo de nuevo."

#: ink_export_dialog.lua
msgid "The image couldn’t be written. The folder may be full."
msgstr "No se pudo escribir la imagen. Puede que la carpeta esté llena."

#: ink_export_dialog.lua
msgid "The PDF couldn’t be written. The folder may be full."
msgstr "No se pudo escribir el PDF. Puede que la carpeta esté llena."

#: ink_export_dialog.lua
msgid "The file couldn’t be written. The folder may be full."
msgstr "No se pudo escribir el archivo. Puede que la carpeta esté llena."

#: ink_export_dialog.lua
msgid "This page couldn’t be drawn for export."
msgstr "No se pudo dibujar esta página para exportarla."

#: ink_export_dialog.lua
msgid "The notebook store isn’t available right now."
msgstr "El almacén de cuadernos no está disponible ahora mismo."

#: ink_export_dialog.lua
msgid "The pages couldn’t be read. Try again."
msgstr "No se pudieron leer las páginas. Inténtalo de nuevo."

